{
  "name": "tft-core-client",
  "version": "0.1.0",
  "description": "Music-server extension protocol client (SOOD discovery, MOO over WebSocket, transport and browse services) for ESP32 and host builds",
  "keywords": "esp32, websocket, moo, sood, music, audio",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/r45635/tft-core-client.git" },
  "authors": [ { "name": "Vincent Cruvellier", "maintainer": true } ],
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "headers": "tftcore/client.h",
  "dependencies": { "bblanchon/ArduinoJson": "^7.4.2" },
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "srcFilter": ["+<*>"],
    "libArchive": false
  },
  "export": { "exclude": ["build", "third_party", "examples/zones_host/build"] }
}
